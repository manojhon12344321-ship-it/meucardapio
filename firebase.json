{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/m/**",
        "destination": "/m/index.html"
      },
      {
        "source": "/painel/**",
        "destination": "/painel/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
